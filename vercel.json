{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/client",
  "framework": null,
  "functions": {
    "api/server.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/ws", "destination": "/api/server" },
    { "source": "/api/(.*)", "destination": "/api/server" },
    { "source": "/((?!api/|ws$|assets/|icons/|manifest.webmanifest|favicon.svg).*)", "destination": "/index.html" }
  ]
}
