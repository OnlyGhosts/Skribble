{
  "name": "Pocket Party",
  "defaultTheme": "dark",
  "fonts": {
    "display": {
      "family": "Space Grotesk",
      "weights": [
        500,
        600,
        700
      ],
      "source": "Google Fonts"
    },
    "body": {
      "family": "Inter",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "source": "Google Fonts"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "weights": [
        500,
        600
      ],
      "source": "Google Fonts"
    }
  },
  "themes": {
    "dark": {
      "--color-bg": "#141514",
      "--color-surface": "#20221F",
      "--color-surface-2": "#2B2E29",
      "--color-surface-3": "#191C19",
      "--color-border": "#454A43",
      "--color-border-strong": "#747D6F",
      "--color-text": "#F1F0E8",
      "--color-text-muted": "#B9C0B3",
      "--color-text-faint": "#9DA796",
      "--color-primary": "#C7E976",
      "--color-primary-hover": "#D5F49B",
      "--color-primary-contrast": "#141514",
      "--color-primary-soft": "#2D381F",
      "--color-primary-text": "#C7E976",
      "--color-secondary": "#A699D5",
      "--color-secondary-hover": "#B8ADE2",
      "--color-secondary-contrast": "#141514",
      "--color-secondary-soft": "#302A40",
      "--color-secondary-text": "#BEB2E8",
      "--color-success": "#86D9A3",
      "--color-success-soft": "#203A2A",
      "--color-success-text": "#A0E9B8",
      "--color-warning": "#F4D181",
      "--color-warning-soft": "#3A3020",
      "--color-warning-text": "#F4D181",
      "--color-danger": "#FF9BA7",
      "--color-danger-soft": "#3D2329",
      "--color-danger-text": "#FFB0BA",
      "--color-info-soft": "#243542",
      "--color-focus": "#C7E976",
      "--overlay-bg": "rgba(0,0,0,0.72)",
