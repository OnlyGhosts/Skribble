      "--chat-correct-bg": "#203A2A",
      "--chat-correct-fg": "#A0E9B8",
      "--chat-close-bg": "#3A3020",
      "--chat-close-fg": "#F4D181",
      "--chat-guessed-bg": "#302A40",
      "--chat-guessed-fg": "#D4C8F5"
