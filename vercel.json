{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "if [ \"$VERCEL_ENV\" = production ]; then export VITE_GAME_SERVER=https://boredgames-io.fly.dev; fi; npm run build:client",
  "outputDirectory": "dist/client",
  "framework": null,
  "fluid": true,
  "functions": {
    "api/server.ts": {
      "maxDuration": 300,
      "excludeFiles": "dist/**"
    }
  },
  "rewrites": [
    { "source": "/ws", "destination": "/api/server" },
    { "source": "/api/(.*)", "destination": "/api/server" },
    { "source": "/((?!api/|ws$|assets/|icons/|manifest.webmanifest|favicon.svg).*)", "destination": "/index.html" }
  ]
}
